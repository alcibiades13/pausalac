# --- Django (apps/api) ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
POSTGRES_DB=pausalac
POSTGRES_USER=pausalac
POSTGRES_PASSWORD=pausalac
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Object storage (MinIO locally, S3-compatible) ---
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=pausalac
AWS_SECRET_ACCESS_KEY=pausalac_local_secret
AWS_STORAGE_BUCKET_NAME=pausalac-documents

# --- Email (MailHog locally) ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
